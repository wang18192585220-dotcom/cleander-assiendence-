# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Calendar (保留，不再作为默认同步方式)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# TickTick API (主要同步方式)
# 获取方式: https://developer.ticktick.com
TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret

# 本地开发:
TICKTICK_REDIRECT_URI=http://localhost:8765/api/ticktick/callback
# 生产环境:
# TICKTICK_REDIRECT_URI=https://你的域名.com/api/ticktick/callback
